# Vite loads .env.development for `npm run dev` and .env.production for `npm run build`.
# Both are generated by `node scripts/db.mjs env <dev|prod>` and committed: the URL and
# publishable key are public (they ship in the browser bundle). Security comes from RLS.
# Use .env.local / .env.development.local (gitignored) for personal overrides.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Comma-separated OAuth buttons to show on the login page (provider must be enabled in Supabase).
VITE_OAUTH_PROVIDERS=
