{
  "name": "united-stoners-of-california",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:db": "node scripts/db.mjs test dev",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "db": "node scripts/db.mjs",
    "db:status": "node scripts/db.mjs status dev && node scripts/db.mjs status prod",
    "db:migrate:dev": "node scripts/db.mjs migrate dev",
    "db:migrate:prod": "node scripts/db.mjs migrate prod",
    "db:seed": "node scripts/db.mjs seed dev",
    "screens": "node scripts/screens.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bootstrap": "^5.3.8",
    "mediabunny": "^1.61.5",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "playwright-core": "^1.64.0",
    "undici": "^8.11.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
