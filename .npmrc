# Works around an npm 10.x arborist crash ("reading edgesOut") when resolving peer deps.
legacy-peer-deps=true
# package-lock.json records the public registry (registry.npmjs.org); npm's default
# replace-registry-host=npmjs rewrites it to whatever registry this machine uses
# (a corporate mirror set in ~/.npmrc, or public npm), so `npm ci` works anywhere.
