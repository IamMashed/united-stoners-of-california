{
  // Cloudflare Worker serving the built frontend (`npm run deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "united-stoners-of-california",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Custom domains: Cloudflare creates the DNS records and TLS certificates on deploy.
  // The workers.dev URL stays enabled as a fallback.
  "routes": [
    { "pattern": "unitedstoners.club", "custom_domain": true },
    { "pattern": "www.unitedstoners.club", "custom_domain": true }
  ],
  "workers_dev": true,
  // Public settings for the contact form (worker/contact.js). Secrets (SUPABASE_SECRET_KEY,
  // CONTACT_TO, RESEND_API_KEY) are set with `npm run db -- worker-secrets prod`; local
  // dev reads them, and a dev SUPABASE_URL, from the gitignored .dev.vars.
  "vars": {
    "SUPABASE_URL": "https://psarkbkrhukowqdivkto.supabase.co",
    "SITE_URL": "https://unitedstoners.club",
    "CONTACT_FROM": "United Stoners of California <no-reply@unitedstoners.club>"
  },
  // At most 3 contact messages per minute per IP.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (e.g. /post/1) serve index.html so React Router can handle them.
    "not_found_handling": "single-page-application",
    // The worker must see requests first to redirect www; it hands everything else to
    // the asset store (free tier: 100k requests/day).
    "run_worker_first": true
  }
}
